{
    "python.languageServer": "Pylance",
    "python.analysis.typeCheckingMode": "off",
    "python.analysis.diagnosticSeverityOverrides": {
        "reportMissingModuleSource": "none"
    },
    "python.terminal.activateEnvironment": false,
    "micropico.openOnStart": true,
    "python.analysis.typeshedPaths": [
        "~/.micropico-stubs/included",
        "/Users/paolo/Library/Python/3.10/lib/python/site-packages"
    ],
    "python.analysis.extraPaths": [
        "~/.micropico-stubs/included",
        "/Users/paolo/Library/Python/3.10/lib/python/site-packages",
        "${workspaceFolder}/external/micropython-lib/micropython/usb/usb-device-midi",
        "${workspaceFolder}/external/micropython-lib/micropython/drivers/display/ssd1306",
        "${workspaceFolder}/external/micropython-tm1637",
        "${workspaceFolder}/lib_common"
    ],
    "python-envs.defaultEnvManager": "ms-python.python:system"
}